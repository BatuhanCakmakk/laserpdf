{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaserPDF",
  "version": "1.0.7",
  "identifier": "com.batuhancakmak.laserpdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LaserPDF",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "PDF görüntüleyici ve düzenleyici",
    "longDescription": "Hafif, hızlı ve şık PDF görüntüleyici ve düzenleyici.",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF belgesi",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["English", "Turkish", "German", "Spanish", "French", "Italian", "PortugueseBR", "Russian", "Japanese", "Korean", "SimpChinese"], "displayLanguageSelector": false }
    }
  }
}
